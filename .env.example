# QuantEmbrace — Environment Configuration Template
#
# Copy this file to .env and fill in your values before running any service.
#
#   cp .env.example .env
#
# NEVER commit .env to git — it contains secrets.
# For production/staging, inject these via EC2 instance profile + Secrets Manager.
#
# ── QUICK START (paper trading on local dev) ─────────────────────────────────
#   1. Fill in ZERODHA_* and ALPACA_* credentials below.
#   2. Set KAFKA_BOOTSTRAP_SERVERS to your MSK endpoint.
#   3. Run: docker-compose up -d (starts LocalStack + local Kafka)
#   4. Run: python scripts/setup_local_tables.py
#   5. Run each service: python -m services.<service_name>.main
#   OR: docker-compose up (all services)

# =============================================================================
# RUNTIME ENVIRONMENT
# =============================================================================

# Environment name: development | staging | production
QE_ENVIRONMENT=development

# =============================================================================
# AWS CONFIGURATION
# =============================================================================

AWS_REGION=ap-south-1
AWS_PROFILE=default                          # Local dev: AWS CLI profile name
                                              # EC2 production: leave unset (uses instance role)

# DynamoDB table prefix — tables are named: <prefix>-orders, <prefix>-positions, etc.
DYNAMODB_TABLE_PREFIX=quantembrace-development

# S3 buckets
AWS_S3_BUCKET_DATA=quantembrace-development-data
AWS_S3_BUCKET_LOGS=quantembrace-development-logs

# LocalStack endpoint — set for local dev only, unset for real AWS
# AWS_ENDPOINT_URL=http://localhost:4566

# =============================================================================
# KAFKA / MSK SERVERLESS
# =============================================================================

# MSK Serverless bootstrap URL (port 9098, SASL/OAUTHBEARER IAM)
# Example: boot-abc123.c1.kafka-serverless.ap-south-1.amazonaws.com:9098
KAFKA_BOOTSTRAP_SERVERS=

# Local dev override — use Redpanda on localhost
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# =============================================================================
# ZERODHA KITE CONNECT (NSE India)
# =============================================================================
# Get API key + secret from: https://developers.kite.trade/
# Tokens expire daily at ~07:30 IST. Run: python scripts/zerodha_login.py each morning.

ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Access token is refreshed daily via scripts/zerodha_login.py (stored in DynamoDB).
# For local dev without DynamoDB, set this directly — it expires by next morning.
ZERODHA_ACCESS_TOKEN=

# =============================================================================
# ALPACA (US Equities)
# =============================================================================
# Get API keys from: https://app.alpaca.markets/
# Paper trading is enabled by default (safe). Set ALPACA_USE_PAPER=false for live.

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Paper trading endpoint (default — safe for dev/staging)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_USE_PAPER=true

# Live endpoint — only set for production after completing 5-day paper validation
# ALPACA_BASE_URL=https://api.alpaca.markets
# ALPACA_USE_PAPER=false

# =============================================================================
# RISK ENGINE
# =============================================================================

# Risk profile: paper | shadow | tiny-live | medium-live
RISK_PROFILE=paper

# Drawdown halt threshold — % of NAV before trading is halted
RISK_DAILY_LOSS_HALT_PCT=3.0

# =============================================================================
# EXECUTION ENGINE
# =============================================================================

# Paper trading simulation parameters (only used when signal.paper_trade=True)
# All other signals (live) bypass these and go directly to the broker.
EXECUTION_PAPER_SLIPPAGE_BPS=5.0
EXECUTION_PAPER_SPREAD_BPS=10.0
EXECUTION_PAPER_LATENCY_MS=250
EXECUTION_PAPER_PARTIAL_FILL_PROBABILITY=0.0
EXECUTION_PAPER_REJECT_PROBABILITY=0.0
EXECUTION_PAPER_MARKET_OPEN_GAP_BPS=0.0
EXECUTION_PAPER_CIRCUIT_LOCK_PROBABILITY=0.0
EXECUTION_PAPER_RANDOM_SEED=quantembrace-paper-v1

# =============================================================================
# STRATEGY ENGINE
# =============================================================================

# All strategies start paper_trade=True by default (set in DynamoDB strategy-config).
# To promote a strategy to live: update DynamoDB quantembrace-strategy-config table.
STRATEGY_CONFIG_RELOAD_INTERVAL_SECONDS=60

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG   # Verbose — enable for local debugging only

# =============================================================================
# HEALTH CHECK
# =============================================================================

QE_HEALTH_CHECK_PORT=8080

# =============================================================================
# SESSIONS TABLE
# =============================================================================

# DynamoDB table storing Zerodha access tokens (managed by ZerodhaTokenManager)
DYNAMODB_TABLE_SESSIONS=quantembrace-development-sessions
